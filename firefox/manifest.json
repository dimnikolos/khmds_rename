{
  "manifest_version": 3,
  "name": "ΚΗΜΔΣ Rename",
  "version": "1.0",
  "description": "Μετονομάζει τα αρχεία που κατεβάζεις από το ΚΗΜΔΣ με τον ΑΔΑΜ",

  "browser_specific_settings": {
    "gecko": {
      "id": "kimdis-rename@dnikolos",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "downloads",
    "webRequest",
    "webRequestBlocking"
  ],

  "host_permissions": [
    "*://cerpp.eprocurement.gov.gr/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://cerpp.eprocurement.gov.gr/*"
      ],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_title": "ΚΗΜΔΣ Rename"
  },

  "data_collection": {
    "collects": false
  }
}